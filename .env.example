# Public site URL, used for canonical links, hreflang, sitemap and Open Graph.
SITE_URL=https://your-domain.com

# Keystatic GitHub mode (production admin). Generated by the setup wizard, see README.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Set to true locally only while running the one-time GitHub App setup.
PUBLIC_KEYSTATIC_GITHUB=false
